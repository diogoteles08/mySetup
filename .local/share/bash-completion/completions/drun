# Bash completion for drun command

_drun_completions() {
  local cur prev words cword
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # Source the shared configuration to get DRUN_COMMANDS array
  source "$HOME/bin/_drun_config.sh"

  if [[ ${COMP_CWORD} -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "${DRUN_COMMANDS[*]}" -- ${cur}) )
    return 0
  fi

  # Example: Add argument completion for a specific subcommand
  # local command="${COMP_WORDS[1]}"
  # case "${command}" in
  #   e2etests)
  #     # Add specific flag/arg completions for 'drun e2etests' here
  #     local opts="--flag1 --flag2"
  #     COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
  #     ;;
  # esac
}

complete -F _drun_completions drun

