#!/bin/bash

# Source the shared configuration
source "$HOME/bin/_drun_config.sh" || exit 1

# Function to get the google3 root directory
get_google3_root() {
  local g3_root
  g3_root=$(p4 g4d 2>/dev/null)
  if [[ -n "$g3_root" ]]; then
    echo "$g3_root"
    return 0
  else
    return 1
  fi
}

show_help() {
  echo "Usage: drun <command> [args...]"
  echo "Available commands:"
  for cmd in "${DRUN_COMMANDS[@]}"; do
    echo "  $cmd"
  done
}

COMMAND="$1"
if [[ -z "$COMMAND" ]]; then
  show_help
  exit 1
fi
shift # Remove the command from arguments, rest are passed to the subcommand

case "$COMMAND" in

  e2etests)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'e2etests' must be run from within a CitC client." >&2
      exit 1
    fi
    echo "Running e2etests..."
    TARGET_DIR="${G3_ROOT}/security/opensource/exit_gate_v1/src/ops/e2etests"
    if [[ ! -d "$TARGET_DIR" ]]; then
      echo "Error: Directory not found: $TARGET_DIR" >&2
      exit 1
    fi
    echo "Changing to $TARGET_DIR"
    pushd "$TARGET_DIR" > /dev/null
    blaze run :e2etests -- "$@"
    popd > /dev/null
    ;;

  push_trigger)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'e2etests' must be run from within a CitC client." >&2
      exit 1
    fi
    echo "Building trigger and pushing into trigger_binary:diogoteles"
    blaze run //security/opensource/exit_gate_v1/src/cmd/trigger:trigger_image_push --define "TAG=diogoteles"

    echo "Deploying job trigger_binary:diogoteles to Cloud Run trigger_workflow"
    gcloud run deploy trigger-workflow --project=oss-exit-gate-dev --region=us-central1 --image=us-docker.pkg.dev/oss-exit-gate-dev/oss-exit-gate/trigger-binary:diogoteles
    ;;

  push_jobs)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'e2etests' must be run from within a CitC client." >&2
      exit 1
    fi

    # @ Propagates the arguments 
    sh "${G3_ROOT}/security/opensource/exit_gate_v1/src/cmd/buildhelper/run.sh" push-jobs "$@"

    ;;
  

  tf_apply)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'e2etests' must be run from within a CitC client." >&2
      exit 1
    fi
    sh ~/tfapply.sh
    ;;

  tf_fix)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'e2etests' must be run from within a CitC client." >&2
      exit 1
    fi

    WORKSPACE_NAME=$(pwd | awk -F/ '{print $6}')
    ENV_DIRECTORY="/google/src/cloud/${USER}/${WORKSPACE_NAME}/google3/configs/cloud/gong/services/oss_exit_gate/envs/dev"
    pushd "${ENV_DIRECTORY}"

    # Ref: https://yaqs.corp.google.com/eng/q/5250254884048994304
    rm -rf .terraform .terraform.lock.hcl
    /google/bin/releases/g3terraform/runner_main --terraform_binary /bin/rm -- -rf /tf_plugin_cache/registry.terraform.io/

    popd
    ;;

  local_list)
    echo "Running local_list..."
    echo "This command does not require a CitC client."
    echo "Listing files in the current directory:"
    ls -lH "$@"
    ;;

  casper)
    TARGET_DIR="$HOME/casper/main"
    if [[ ! -d "$TARGET_DIR" ]]; then
      echo "Error: Directory not found: $TARGET_DIR" >&2
      exit 1
    fi
    echo "Running Casper CLI from main worktree..."
    pushd "$TARGET_DIR" > /dev/null
    make build-cli > /dev/null
    ./bin/casper "$@"
    popd > /dev/null
    ;;

  help)
    show_help
    ;;

  jetsky-permissions-sync)
    G3_ROOT=$(get_google3_root)
    if [[ $? -ne 0 ]]; then
      echo "Error: 'jetsky-permissions-sync' must be run from within a CitC client." >&2
      exit 1
    fi
    CLIENT_ROOT=$(dirname "${G3_ROOT}")
    SYNC_SCRIPT="${CLIENT_ROOT}/configs/users/${USER}/_agents/sync_permissions.py"
    if [[ ! -x "$SYNC_SCRIPT" ]]; then
      echo "Error: Sync script not found or not executable: $SYNC_SCRIPT" >&2
      exit 1
    fi
    echo "Running permissions sync..."
    "$SYNC_SCRIPT" "$@"
    ;;

  *)
    # Check if the command exists in the list
    is_known=0
    for cmd in "${DRUN_COMMANDS[@]}"; do
      if [[ "$cmd" == "$COMMAND" ]]; then
        is_known=1
        break
      fi
    done

    if [[ $is_known -eq 0 ]]; then
         echo "Error: Unknown command '$COMMAND'" >&2
         show_help
         exit 1
    else
         echo "Error: Command '$COMMAND' is defined in _drun_config.sh but not handled in the drun script." >&2
         exit 1
    fi
    ;;
esac

